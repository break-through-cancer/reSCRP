// Sidebar / Topbar
nav.navbar.navbar-expand.navbar-light.bg-white.topbar.mb-4.static-top.shadow
  // Sidebar Toggle (Topbar)
  button#sidebarToggleTop.btn.btn-link.d-md-none.rounded-circle.mr-3
    i.fa.fa-bars

  // Logo + Title
  div.pagelogotitle
    div.pagelogo
      a.mda-nav-logo(href="https://singlecell.mdanderson.org/", target="_self")
        img(
          src="/assets/img/xmda-logo.png.pagespeed.ic.wI3LdrsTIB.png",
          alt="The University of Texas MD Anderson Cancer Center",
          height="100%"
        )
    div.majortitle
      h1.h3.mb-0.text-gray-800 Ovarian MRD

  // Right-side Navbar
  ul.navbar-nav.ml-auto
    // Documentation link
    li.nav-item.no-arrow
      a.nav-link(
        href='https://break-through-cancer.github.io/reSCRP/',
        target='_blank',
        title='Documentation')
        i.fas.fa-book(style='font-size:1.5rem;', aria-label='Documentation')

    // Tutorial link
    li.nav-item.no-arrow
      a.nav-link(
        href='https://break-through-cancer.github.io/reSCRP/getting-started/tutorial-ovmrd/',
        target='_blank',
        title='Tutorial')
        i.fas.fa-code(style='font-size:1.5rem;', aria-label='Tutorial')

    // Alerts
    li.nav-item.dropdown.no-arrow.mx-1
      a#alertsDropdown.nav-link.dropdown-toggle(
        href='#',
        role='button',
        data-toggle='dropdown',
        aria-haspopup='true',
        aria-expanded='false')
        i.fas.fa-bell.fa-fw
        span.badge.badge-danger.badge-counter 1+
      .dropdown-list.dropdown-menu.dropdown-menu-right.shadow.animated--grow-in(
        aria-labelledby='alertsDropdown')
        h6.dropdown-header Notification
        a.dropdown-item.d-flex.align-items-center(href='#')
          .mr-3
            .icon-circle.bg-primary
              i.fas.fa-file-alt.text-white
          div
            .small.text-gray-500 October 2025
            span.font-weight-bold Data upload and preprocessing complete

    // Messages / Contact
    li.nav-item.dropdown.no-arrow.mx-1
      a#messagesDropdown.nav-link.dropdown-toggle(
        href='#',
        role='button',
        data-toggle='dropdown',
        aria-haspopup='true',
        aria-expanded='false')
        i.fas.fa-envelope.fa-fw
        span.badge.badge-danger.badge-counter 2
      .dropdown-list.dropdown-menu.dropdown-menu-right.shadow.animated--grow-in(
        aria-labelledby='messagesDropdown')
        h6.dropdown-header Contact
        a.dropdown-item.d-flex.align-items-center(href='#')
          .dropdown-list-image.mr-3
            img.rounded-circle(src='/assets/img/undraw_profile_2.svg', alt='...')
            .status-indicator.bg-success
          .font-weight-bold
            .text-truncate renad.alghazawi @ mdanderson.org
            .small.text-gray-500 Ovarian MRD Module Lead
        a.dropdown-item.d-flex.align-items-center(href='#')
          .dropdown-list-image.mr-3
            img.rounded-circle(src='/assets/img/undraw_profile_1.svg', alt='...')
            .status-indicator
          div
            .text-truncate linghua22 @ mdanderson.org
            .small.text-gray-500 Linghua Wang Lab, Genomic Medicine
