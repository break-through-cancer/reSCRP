// Sidebar
nav.navbar.navbar-expand.navbar-light.bg-white.topbar.mb-4.static-top.shadow
  // Sidebar Toggle (Topbar)
  button#sidebarToggleTop.btn.btn-link.d-md-none.rounded-circle.mr-3
    i.fa.fa-bars
  div.pagelogotitle
    div.pagelogo
      a.mda-nav-logo(href="https://singlecell.mdanderson.org/",target="_self")
        img(src="/assets/img/xmda-logo.png.pagespeed.ic.wI3LdrsTIB.png", alt="The University of Texas MD Anderson Cancer Center", height = "100%")
    div.majortitle
      h1.h3.mb-0.text-gray-800
        | B Cell Landscape in Lung Cancer
  ul.navbar-nav.ml-auto
    // Documentation link
    li.nav-item.no-arrow
      a.nav-link(href='https://break-through-cancer.github.io/reSCRP/', target='_blank', title='Documentation')
        i.fas.fa-book(style='font-size: 1.5rem;', aria-label='Documentation')
    // User dropdown menu combining profile and auth
    if authEnabled
      if isAuthenticated
        li.nav-item.dropdown.no-arrow
          a#userDropdown.nav-link.dropdown-toggle(href='#',role='button',data-toggle='dropdown',aria-haspopup='true',aria-expanded='false')
            i.fas.fa-user-circle.fa-fw.mr-1
            span.d-none.d-lg-inline.text-gray-600.small #{user.name || user.username || 'User'}
          .dropdown-menu.dropdown-menu-right.shadow.animated--grow-in(aria-labelledby='userDropdown')
            a.dropdown-item(href='/auth/profile')
              i.fas.fa-user.fa-sm.fa-fw.mr-2.text-gray-400
              | Profile
            .dropdown-divider
            a.dropdown-item(href='/auth/logout')
              i.fas.fa-sign-out-alt.fa-sm.fa-fw.mr-2.text-gray-400
              | Sign Out
      else
        li.nav-item.dropdown.no-arrow
          a#menuDropdown.nav-link.dropdown-toggle(href='#',role='button',data-toggle='dropdown',aria-haspopup='true',aria-expanded='false')
            i.fas.fa-bars(style='font-size: 1.5rem;')
            span.d-none.d-lg-inline.text-gray-600.small.ml-1 Menu
          .dropdown-menu.dropdown-menu-right.shadow.animated--grow-in(aria-labelledby='menuDropdown')
            a.dropdown-item(href='/auth/login')
              i.fas.fa-sign-in-alt.fa-sm.fa-fw.mr-2.text-gray-400
              | Sign In
    li.nav-item.dropdown.no-arrow.mx-1
      a#alertsDropdown.nav-link.dropdown-toggle(href='#',role='button',data-toggle='dropdown',aria-haspopup='true',aria-expanded='false')
        i.fas.fa-bell.fa-fw
        // Counter - Alerts
        span.badge.badge-danger.badge-counter 1+
      // Dropdown - Alerts
      .dropdown-list.dropdown-menu.dropdown-menu-right.shadow.animated--grow-in(aria-labelledby='alertsDropdown')
        h6.dropdown-header
          | Notification
        a.dropdown-item.d-flex.align-items-center(href='#')
          .mr-3
            .icon-circle.bg-primary
              i.fas.fa-file-alt.text-white
          div
            .small.text-gray-500 November 21, 2021
            span.font-weight-bold Data submition is on going!
        // Nav Item - Messages
        li.nav-item.dropdown.no-arrow.mx-1
          a#messagesDropdown.nav-link.dropdown-toggle(href='#',role='button',data-toggle='dropdown',aria-haspopup='true',aria-expanded='false')
            i.fas.fa-envelope.fa-fw
            // Counter - Messages
            span.badge.badge-danger.badge-counter 2
          // Dropdown - Messages
          .dropdown-list.dropdown-menu.dropdown-menu-right.shadow.animated--grow-in(aria-labelledby='messagesDropdown')
            h6.dropdown-header
              | Contact
            a.dropdown-item.d-flex.align-items-center(href='#')
              .dropdown-list-image.mr-3
                img.rounded-circle(src='img/undraw_profile_2.svg',alt='...')
                .status-indicator.bg-success
              .font-weight-bold
                .text-truncate HKadara at mdanderson.org
                .small.text-gray-500 Kadara Humam, MD anderson cancer center
            a.dropdown-item.d-flex.align-items-center(href='#')
              .dropdown-list-image.mr-3
                img.rounded-circle(src='img/undraw_profile_2.svg',alt='...')
                .status-indicator.bg-success
              .font-weight-bold
                .text-truncate yanshuoc at gmail.com
                .small.text-gray-500 Yanshuo Chu, MD anderson cancer center
            a.dropdown-item.d-flex.align-items-center(href='#')
              .dropdown-list-image.mr-3
                img.rounded-circle(src='img/undraw_profile_1.svg',alt='...')
                .status-indicator
              div
                .text-truncate linghua22 at mdanderson.org
                .small.text-gray-500 Linghua Wang, MD anderson cancer center
